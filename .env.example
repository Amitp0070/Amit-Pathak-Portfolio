# ============================================================
#  Visitor Tracking — environment keys
#  Copy this file to ".env" and fill in your real values.
#    cp .env.example .env        (macOS / Linux / Git Bash)
#    copy .env.example .env      (Windows CMD)
#
#  IMPORTANT: every VITE_ value below is bundled into the built
#  JavaScript and is therefore PUBLIC (visible in page source).
#  This is the accepted trade-off of a no-backend setup. The bot
#  can only message YOU; if abused, rotate the token in @BotFather.
#  Never commit your real ".env" — it is already in .gitignore.
# ============================================================

# --- Telegram (instant ping on each visit) ---
# 1. In Telegram, message @BotFather -> /newbot -> copy the token.
VITE_TELEGRAM_BOT_TOKEN=
# 2. Message @userinfobot -> copy the numeric "Id".
VITE_TELEGRAM_CHAT_ID=

# --- Google Sheet (searchable log of every visit) ---
# Apps Script -> Deploy -> Web app -> copy the /exec URL (see README).
VITE_SHEET_WEBAPP_URL=
# --- Optional ---
# Geo-IP provider (default is https://ipwho.is/ , free, no key).
# VITE_GEO_API_URL=https://ipwho.is/
# Track during `npm run dev` too (default: production only).
# VITE_TRACK_IN_DEV=True
# Verbose console logs + window.__vtFlush() for manual testing.
# VITE_TRACK_DEBUG=false
